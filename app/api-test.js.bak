    padding: 12,
    borderRadius: 8,
    marginRight: 8,
    minWidth: 120,
    elevation: 1,
  },
  endpointMethod: {
    fontWeight: 'bold',
    color: '#0066CC',
    marginBottom: 4,
  },
  endpointPath: {
    fontSize: 12,
    color: '#666',
  },
  loadingContainer: {
    padding: 20,
    alignItems: 'center',
  },
  loadingText: {
    marginTop: 10,
    color: '#666',
  },
  resultsTitle: {
    fontSize: 18,
    fontWeight: 'bold',
    marginBottom: 10,
    color: '#333',
  },
  resultsContainer: {
    flex: 1,
  },
  noResults: {
    textAlign: 'center',
    color: '#999',
    padding: 40,
  },
